{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gdrive",
  "version": "3.9.1",
  "identifier": "com.infranettone.gdrive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "gdrive",
        "width": 1100,
        "height": 760,
        "minWidth": 860,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Google Drive from your desktop",
    "longDescription": "Desktop app for gdrive: manage Google Drive accounts, files, shared drives and permissions. Includes a guided wizard for creating the Google OAuth credentials gdrive needs.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
